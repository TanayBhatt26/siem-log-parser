# Copy to .env (git-ignored) and adjust.
# Required for Elasticsearch/Kibana security
ELASTIC_PASSWORD=your-strong-elastic-password
KIBANA_PASSWORD=your-strong-kibana-password

# Optional: AbuseIPDB API key for threat intelligence enrichment
# Get one at https://www.abuseipdb.com/api.html
# ABUSEIPDB_API_KEY=your-api-key

# Optional: Anthropic API key for LLM triage
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key

# SIEM_API_KEY for API authentication (if exposing API publicly)
# Generate with: openssl rand -hex 32
# SIEM_API_KEY=your-random-api-key